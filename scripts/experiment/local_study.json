{
  "_about": "The one config of the local-model study (study 5). local_run.py, local_analyze.py and LOCAL_STUDY.md read every study value from here; the tasks themselves (prompts, seed, checks) are the shared tasks.json named under tasks, the same definition study 4 uses. Paths are relative to the repository root. Secrets never go here: the LM Studio token and the Honeycomb key are read from the environment variables named below (or .env.local, read-only).",
  "study": "local-models",
  "question": "How reliably do local models that can do the work complete the tasks through mcp-for-kibana, and how long do they take?",

  "models": [
    "nvidia/nemotron-3-nano-4b",
    "nvidia/nemotron-3-nano-omni",
    "google/gemma-4-12b-qat",
    "qwen/qwen3.8-27b"
  ],

  "lmstudio": {
    "url": "http://localhost:1234",
    "token_env": "LMSTUDIO_API_TOKEN",
    "mcp_json": "~/.lmstudio/mcp.json",
    "load": "harness",
    "stream": true,
    "run_timeout_s": 1800,
    "idle_timeout_s": 600,
    "min_context_length": 131072
  },

  "server": {
    "entry": "mcp-for-kibana-study",
    "toolboxes": "dashboards,data-management,alerting",
    "tier": "write",
    "expected_tools": 25,
    "required_tools": [
      "describe_data_view",
      "create_dashboard",
      "add_panel",
      "update_panel",
      "get_dashboard",
      "create_alert_rule",
      "enable_alert_rule",
      "get_alert_rule",
      "list_alert_rules"
    ]
  },

  "kibana": {
    "version": "9.5.5",
    "seed_file": "elastic-start-local/.env.seed",
    "marker_prefix": "LOC"
  },

  "tasks": {
    "file": "scripts/experiment/tasks.json",
    "arm": "server",
    "stage1": ["weblogs"],
    "stage2": ["change", "lookup", "flights"],
    "pass_mark": 14
  },

  "runs": {
    "pilot_per_cell": 3,
    "per_cell": 20,
    "order": "rotate",
    "max_attempts": 3,
    "budget_hours": 12,
    "out_dir": "scripts/experiment/runs/study5"
  },

  "honeycomb": {
    "dataset": "mcp-for-kibana-local",
    "endpoint": "https://api.eu1.honeycomb.io/v1/traces",
    "key_env": "HONEYCOMB_API_KEY",
    "required": false,
    "message_cap_bytes": 16000,
    "tool_cap_bytes": 8000
  },

  "analysis": {
    "pass_hat_k": [2, 3]
  }
}
