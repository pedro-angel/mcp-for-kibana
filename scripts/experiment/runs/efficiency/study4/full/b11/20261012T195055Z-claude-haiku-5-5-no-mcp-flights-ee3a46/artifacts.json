    {
      "id": "869a3035-446d-4b16-8f6c-030240aeda49",
      "enabled": true,
      "name": "S4-90029e56 Cancelled flights",
      "tags": [],
      "rule_type_id": ".es-query",
      "consumer": "stackAlerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "esqlQuery",
        "esqlQuery": {
          "esql": "FROM kibana_sample_data_flights | WHERE Cancelled == true | STATS cancelled_flights = COUNT(*) | WHERE cancelled_flights > 10"
        },
        "timeField": "timestamp",
        "size": 0,
        "timeWindowSize": 5,
        "timeWindowUnit": "m",
        "threshold": [
