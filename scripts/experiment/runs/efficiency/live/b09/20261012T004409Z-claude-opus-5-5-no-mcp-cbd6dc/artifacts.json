  "rules": [
    {
      "id": "6e2fc675-8026-4454-b240-d45af096d242",
      "enabled": true,
      "name": "EFF-77649760 5xx spike",
      "tags": [
        "web-logs"
      ],
      "rule_type_id": ".es-query",
      "consumer": "stackAlerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "esQuery",
        "index": [
          "kibana_sample_data_logs"
        ],
        "timeField": "timestamp",
        "esQuery": "{\"query\":{\"range\":{\"response.keyword\":{\"gte\":\"500\",\"lt\":\"600\"}}}}",
        "size": 0,
        "threshold": [
          10
        ],
        "thresholdComparator": ">",
        "timeWindowSize": 5,
        "timeWindowUnit": "m",
        "excludeHitsFromPreviousRun": false,
        "aggType": "count",
        "groupBy": "all"
      },
