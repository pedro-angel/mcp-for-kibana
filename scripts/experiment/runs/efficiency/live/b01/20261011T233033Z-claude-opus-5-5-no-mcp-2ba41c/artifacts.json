    {
      "id": "9e5dc1fb-a5fb-4833-867d-b6444bd256b9",
      "enabled": true,
      "name": "EFF-8b9c7d9d 5xx spike",
      "tags": [
        "web-logs",
        "5xx"
      ],
      "rule_type_id": ".es-query",
      "consumer": "alerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "esQuery",
        "index": [
          "kibana_sample_data_logs"
        ],
        "timeField": "timestamp",
        "esQuery": "{\"query\": {\"bool\": {\"filter\": [{\"range\": {\"response.keyword\": {\"gte\": \"500\", \"lt\": \"600\"}}}]}}}",
        "size": 0,
        "threshold": [
          10
        ],
        "thresholdComparator": ">",
        "timeWindowSize": 5,
        "timeWindowUnit": "m",
        "excludeHitsFromPreviousRun": true,
        "aggType": "count",
        "groupBy": "all"
      },
