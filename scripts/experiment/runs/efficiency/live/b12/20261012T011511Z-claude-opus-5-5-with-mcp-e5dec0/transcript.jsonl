ng a connector (for example Slack or email) would fix that.","ttft_ms":1896,"type":"result","duration_ms":28406,"uuid":"41c88ae5-973e-477c-a60e-9e56bc1fdcdd","ttft_stream_ms":1606,"time_to_request_ms":136,"time_to_request_phases_ms":{"other":32,"system_prompt":14,"resume_other":0,"process_user_input":5,"input_attachments":16,"input_hooks":6,"tool_pool_refresh":5,"init_message":3,"engine_pickup":2,"message_prep":2,"model_config_wait":2,"autocompact":3,"query_setup":1,"model_gates":0,"tool_schema_build":18,"message_normalization":4,"client_creation":4,"request_build":19},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":86,"time_to_request_cpu_ms":178,"time_to_request_major_faults":0,"input_attachments_detail":{"slowest_producer":"queued_commands","slowest_producer_ms":9,"cpu_ms":23,"major_faults":0},"first_content_frame_ms":1607,"time_to_request_from_spawn_ms":8538989,"warm_spare_claimed":false,"flag_fetch_kick":"not_asked_warm","time_origin_ms":1791767711819.6167,"queued_turn_count":0,"result_index":0}
