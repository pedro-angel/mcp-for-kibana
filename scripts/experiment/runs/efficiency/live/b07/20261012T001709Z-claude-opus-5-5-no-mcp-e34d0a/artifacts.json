              "data_source": {
                "type": "esql",
                "query": "FROM kibana_sample_data_logs | WHERE @timestamp >= ?_tstart AND @timestamp <= ?_tend | EVAL is_5xx = CASE(response.keyword LIKE \"5*\", 1, 0) | STATS errors = SUM(is_5xx), total = COUNT(*) | EVAL error_rate = ROUND(100.0 * errors / total, 2) | KEEP error_rate"
