  "rules": [
    {
      "id": "603e4161-5321-4bf4-8354-50cbff0db606",
      "enabled": true,
      "name": "EFF-431dd356 5xx spike",
      "tags": [],
      "rule_type_id": ".es-query",
      "consumer": "alerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "esQuery",
        "index": [
          "kibana_sample_data_logs"
        ],
        "timeField": "timestamp",
        "esQuery": "{\"query\":{\"regexp\":{\"response.keyword\":\"5[0-9][0-9]\"}}}",
        "size": 100,
        "timeWindowSize": 5,
        "timeWindowUnit": "m",
        "threshold": [
          10
        ],
        "thresholdComparator": ">",
        "excludeHitsFromPreviousRun": true,
        "aggType": "count",
        "groupBy": "all"
