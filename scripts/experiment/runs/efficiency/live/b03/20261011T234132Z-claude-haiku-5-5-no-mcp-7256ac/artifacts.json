  "rules": [
    {
      "id": "a6b6d74c-0eb6-4085-8687-eeaeeafb6870",
      "enabled": true,
      "name": "EFF-9df6ad4d 5xx spike",
      "tags": [
        "EFF-9df6ad4d"
      ],
      "rule_type_id": ".es-query",
      "consumer": "alerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "searchSource",
        "searchConfiguration": {
          "query": {
            "language": "kuery",
            "query": "response.keyword >= \"500\" and response.keyword <= \"599\""
          },
          "index": "90943e30-9a47-11e8-b64d-95841ca0b247"
        },
        "timeField": "@timestamp",
        "timeWindowSize": 5,
        "timeWindowUnit": "m",
        "aggType": "count",
        "groupBy": "all",
        "thresholdComparator": ">",
        "threshold": [
          10
        ],
        "size": 100,
        "excludeHitsFromPreviousRun": false
      },
