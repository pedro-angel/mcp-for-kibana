  "rules": [
    {
      "id": "06c2ec76-5091-43ff-9245-77d005bcd357",
      "enabled": true,
      "name": "EFF-2a763206 5xx spike",
      "tags": [
        "EFF-2a763206"
      ],
      "rule_type_id": ".es-query",
      "consumer": "stackAlerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "esQuery",
        "index": [
          "kibana_sample_data_logs"
        ],
        "timeField": "@timestamp",
        "timeWindowSize": 5,
        "timeWindowUnit": "m",
        "thresholdComparator": ">",
        "threshold": [
          10
        ],
        "size": 100,
        "esQuery": "{\"query\":{\"bool\":{\"filter\":[{\"range\":{\"@timestamp\":{\"gte\":\"now-5m\",\"lte\":\"now\"}}},{\"wildcard\":{\"response.keyword\":{\"value\":\"5*\"}}}]}}}",
        "excludeHitsFromPreviousRun": true,
        "aggType": "count",
        "groupBy": "all"
      },
      "scheduled_task_id": "06c2ec76-5091-43ff-9245-77d005bcd357",
