      },
      "actions": [],
      "params": {
        "searchType": "esQuery",
        "index": [
          "kibana_sample_data_logs"
        ],
        "timeField": "timestamp",
        "esQuery": "{\"query\":{\"bool\":{\"filter\":[{\"wildcard\":{\"response.keyword\":\"5*\"}}]}}}",
