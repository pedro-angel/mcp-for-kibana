    {
      "id": "00f36b15-7c5d-4866-a39d-2c649743d06c",
      "enabled": true,
      "name": "EFF-c7f7ffb1 5xx spike",
      "tags": [],
      "rule_type_id": ".es-query",
      "consumer": "alerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "esQuery",
        "index": [
          "kibana_sample_data_logs"
        ],
        "timeField": "timestamp",
        "esQuery": "{\"query\":{\"bool\":{\"filter\":[{\"regexp\":{\"response.keyword\":\"5[0-9][0-9]\"}}]}}}",
        "size": 0,
        "threshold": [
          10
        ],
        "thresholdComparator": ">",
        "timeWindowSize": 5,
        "timeWindowUnit": "m",
        "excludeHitsFromPreviousRun": true,
        "aggType": "count",
        "groupBy": "all"
