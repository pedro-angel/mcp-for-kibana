    {
      "id": "43b0a948-0e80-484b-8903-de8faca4f0a1",
      "enabled": true,
      "name": "EFF-569371b0 5xx spike",
      "tags": [],
      "rule_type_id": ".es-query",
      "consumer": "alerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "esQuery",
        "index": [
          "kibana_sample_data_logs"
        ],
        "timeField": "timestamp",
        "esQuery": "{\"query\": {\"bool\": {\"filter\": [{\"regexp\": {\"response.keyword\": \"5[0-9][0-9]\"}}]}}}",
        "size": 100,
        "threshold": [
