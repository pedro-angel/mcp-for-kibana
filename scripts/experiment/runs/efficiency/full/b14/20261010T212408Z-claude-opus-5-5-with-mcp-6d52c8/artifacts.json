      "id": "3c6a665a-41e9-4a12-bb89-a7fdfa538f40",
      "enabled": true,
      "name": "EFF-70422ab6 5xx spike",
      "tags": [
        "web-logs",
        "5xx"
      ],
      "rule_type_id": ".es-query",
      "consumer": "stackAlerts",
      "schedule": {
