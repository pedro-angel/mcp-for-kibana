      "id": "40b971d7-974a-4c21-ba62-48f5e417f861",
      "enabled": true,
      "name": "EFF-2e647aee 5xx spike",
      "tags": [],
      "rule_type_id": ".es-query",
      "consumer": "alerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "esQuery",
        "index": [
          "kibana_sample_data_logs"
        ],
        "timeField": "timestamp",
        "esQuery": "{\"query\":{\"bool\":{\"filter\":[{\"regexp\":{\"response\":\"5[0-9][0-9]\"}}]}}}",
        "size": 100,
        "threshold": [
