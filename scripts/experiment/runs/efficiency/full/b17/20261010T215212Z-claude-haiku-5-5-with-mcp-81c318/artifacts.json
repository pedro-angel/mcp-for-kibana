        "esQuery": "{\"query\":{\"bool\":{\"filter\":[{\"range\":{\"@timestamp\":{\"gte\":\"now-5m\",\"lte\":\"now\"}}},{\"range\":{\"response.keyword\":{\"gte\":\"500\",\"lte\":\"599\"}}}]}}}",
