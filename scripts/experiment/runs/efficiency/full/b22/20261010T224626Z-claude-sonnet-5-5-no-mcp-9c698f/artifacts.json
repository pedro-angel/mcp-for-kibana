      "id": "f391f43b-e026-4760-9c86-f281c42033df",
      "enabled": true,
      "name": "EFF-74cb2864 5xx spike",
      "tags": [],
      "rule_type_id": ".es-query",
      "consumer": "alerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "esQuery",
        "index": [
          "kibana_sample_data_logs"
        ],
        "timeField": "timestamp",
        "esQuery": "{\"query\":{\"bool\":{\"filter\":[{\"regexp\":{\"response.keyword\":\"5[0-9][0-9]\"}}]}}}",
        "size": 100,
        "threshold": [
          10
        ],
        "thresholdComparator": ">",
        "timeWindowSize": 5,
        "timeWindowUnit": "m",
        "excludeHitsFromPreviousRun": true,
        "aggType": "count",
        "groupBy": "all"
