    {
      "id": "a053ee83-e294-40b3-98c3-9e5239120911",
      "enabled": true,
      "name": "EFF-e1241807 5xx spike",
      "tags": [],
      "rule_type_id": ".es-query",
      "consumer": "alerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "esQuery",
        "index": [
          "kibana_sample_data_logs"
        ],
        "timeField": "timestamp",
        "esQuery": "{\"query\":{\"regexp\":{\"response.keyword\":\"5[0-9][0-9]\"}}}",
        "size": 100,
        "threshold": [
