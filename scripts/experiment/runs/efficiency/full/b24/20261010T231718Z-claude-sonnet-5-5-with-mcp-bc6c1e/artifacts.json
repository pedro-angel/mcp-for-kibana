    {
      "id": "66a4d573-ee33-487f-9440-504c233a61bb",
      "enabled": false,
      "name": "EFF-ede2034d 5xx spike",
      "tags": [],
      "rule_type_id": ".es-query",
      "consumer": "stackAlerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "esQuery",
        "esQuery": "{\"query\":{\"regexp\":{\"response.keyword\":\"5[0-9][0-9]\"}}}",
        "index": [
          "kibana_sample_data_logs"
        ],
        "timeField": "timestamp",
        "threshold": [
          10
        ],
        "thresholdComparator": ">",
        "timeWindowSize": 5,
        "timeWindowUnit": "m",
        "size": 100,
        "excludeHitsFromPreviousRun": true,
        "aggType": "count",
        "groupBy": "all"
