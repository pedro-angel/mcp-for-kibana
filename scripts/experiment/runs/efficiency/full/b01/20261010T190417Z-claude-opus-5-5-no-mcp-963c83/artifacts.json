  "rules": [
    {
      "id": "33d036ba-8075-4e54-b714-45d6bfb75c6d",
      "enabled": true,
      "name": "EFF-0f4ab157 5xx spike",
      "tags": [
        "web-logs"
      ],
      "rule_type_id": ".es-query",
      "consumer": "stackAlerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "esQuery",
        "index": [
          "kibana_sample_data_logs"
        ],
        "timeField": "timestamp",
        "esQuery": "{\"query\":{\"range\":{\"response.keyword\":{\"gte\":\"500\",\"lt\":\"600\"}}}}",
        "size": 100,
        "aggType": "count",
        "groupBy": "all",
        "threshold": [
          10
        ],
        "thresholdComparator": ">",
        "timeWindowSize": 5,
        "timeWindowUnit": "m",
        "excludeHitsFromPreviousRun": false
      },
