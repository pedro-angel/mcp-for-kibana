  "rules": [
    {
      "id": "e0f74c9d-5f7c-4a59-a84d-dce33b8b33d7",
      "enabled": true,
      "name": "EFF-3387fe08 5xx spike",
      "tags": [
        "web-logs"
      ],
      "rule_type_id": ".es-query",
      "consumer": "stackAlerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "esQuery",
        "index": [
          "kibana_sample_data_logs"
        ],
        "timeField": "timestamp",
        "esQuery": "{\"query\":{\"range\":{\"response.keyword\":{\"gte\":\"500\",\"lt\":\"600\"}}}}",
        "aggType": "count",
        "groupBy": "all",
        "size": 100,
        "threshold": [
          10
        ],
        "thresholdComparator": ">",
        "timeWindowSize": 5,
        "timeWindowUnit": "m",
        "excludeHitsFromPreviousRun": false
      },
