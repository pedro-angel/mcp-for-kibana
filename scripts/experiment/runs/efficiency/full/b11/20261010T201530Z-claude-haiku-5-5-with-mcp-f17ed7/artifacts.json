      "actions": [],
      "params": {
        "searchType": "esqlQuery",
        "esqlQuery": {
          "esql": "FROM kibana_sample_data_logs | WHERE @timestamp >= ?_tstart AND @timestamp < ?_tend AND response.keyword RLIKE \"5[0-9][0-9]\" | STATS errors = COUNT(*) | WHERE errors > 10"
