  "rules": [
    {
      "id": "44a8ea75-ab15-4dcd-9379-b6159b39862d",
      "enabled": true,
      "name": "EFF-547b62ef 5xx spike",
      "tags": [],
      "rule_type_id": ".es-query",
      "consumer": "alerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "esQuery",
        "index": [
          "kibana_sample_data_logs"
        ],
        "timeField": "timestamp",
        "esQuery": "{\"query\":{\"regexp\":{\"response.keyword\":\"5[0-9][0-9]\"}}}",
        "size": 100,
        "threshold": [
          10
        ],
        "thresholdComparator": ">",
        "timeWindowSize": 5,
        "timeWindowUnit": "m",
        "excludeHitsFromPreviousRun": true,
        "aggType": "count",
        "groupBy": "all"
