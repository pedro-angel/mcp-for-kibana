    {
      "id": "d2de17e5-be6c-43d7-a7f7-40311def84cf",
      "enabled": true,
      "name": "EFF-e0638aa9 5xx spike",
      "tags": [],
      "rule_type_id": ".es-query",
      "consumer": "alerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "esQuery",
        "index": [
          "kibana_sample_data_logs"
        ],
        "timeField": "@timestamp",
        "esQuery": "{\"query\":{\"bool\":{\"filter\":[{\"regexp\":{\"response.keyword\":{\"value\":\"5[0-9][0-9]\"}}}]}}}",
        "aggType": "count",
        "groupBy": "all",
        "timeWindowSize": 5,
        "timeWindowUnit": "m",
        "threshold": [
          10
        ],
        "thresholdComparator": ">",
        "size": 100,
        "excludeHitsFromPreviousRun": true
