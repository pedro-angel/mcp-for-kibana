    {
      "id": "b1a00a80-dba4-4535-9bbb-f0aa40321fa0",
      "enabled": true,
      "name": "EFF-f62ebe6d 5xx spike",
      "tags": [
        "web-logs"
      ],
      "rule_type_id": ".es-query",
      "consumer": "stackAlerts",
      "schedule": {
        "interval": "1m"
      },
      "actions": [],
      "params": {
        "searchType": "esQuery",
        "index": [
          "kibana_sample_data_logs"
        ],
        "timeField": "timestamp",
        "esQuery": "{\"query\":{\"range\":{\"response.keyword\":{\"gte\":\"500\",\"lt\":\"600\"}}}}",
        "size": 100,
        "threshold": [
          10
        ],
        "thresholdComparator": ">",
        "timeWindowSize": 5,
        "timeWindowUnit": "m",
        "excludeHitsFromPreviousRun": false,
        "aggType": "count",
        "groupBy": "all"
