{
  "permissions": {
    "allow": ["Bash(uv run python scripts/experiment/efficiency_run.py:*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-session-start.sh"
          }
        ]
      }
    ]
  }
}
