# CI tier slice of the Definition-of-Done gate: STREAMS-EPHEMERAL ONLY.
# Run by .github/workflows/integration.yml's `streams-ephemeral` job:
#   scripts/checks/definition-of-done.sh .github/dod/ci-streams.config
# The criterion's harness (scripts/ephemeral_stack.sh) provisions and tears
# down its own isolated stack — the job needs only docker + uv.
#
# dod.config is the canonical criteria list; every known criterion must be
# declared here (the gate fails closed on omissions — that is the drift guard).
# `n/a` means "certified by another CI job or by the local gate", never
# "waived"; e2e_green is n/a in every CI config because CI has no Claude
# sign-in, and the local dod.config requires it (D42; docs/e2e-setup.md).
unit_green = n/a
ruff_clean = n/a
types_clean = n/a
import_contracts = n/a
hygiene_hooks = n/a
docs_strict = n/a
audit_clean = n/a
sast_clean = n/a
vocabulary_conformant = n/a
image_smoke = n/a
contract_green = n/a
e2e_replay_green = n/a
wheel_replay_green = n/a
e2e_green = n/a
streams_ephemeral = required
fleet_ephemeral = n/a
# changelog_entry: checks.yml runs the same script (scripts/checks/changelog-entry.sh)
# on every PR, against the PR's merge-base with main (D54).
changelog_entry = n/a
