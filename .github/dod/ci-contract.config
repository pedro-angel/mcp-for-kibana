# CI tier slice of the Definition-of-Done gate: THE SEEDED-STACK SUITES.
# Run by .github/workflows/integration.yml's `contract` job after provisioning
# with scripts/stack.sh up && seed (the same scripts local uses):
#   scripts/checks/definition-of-done.sh .github/dod/ci-contract.config
#
# Four criteria, one provisioned stack: contract_green (the gateway/fleet
# contracts), e2e_replay_green (recorded real-model turns, every toolbox,
# replayed through a real MCP client against that same stack; D61),
# wheel_replay_green (the same replay against the built wheel installed into a
# fresh venv) and image_replay_green (the same replay against the built Docker
# image over HTTP, the key in the Authorization header; the gate builds the
# image first; D62). They share this
# tier because they share the precondition — a seeded stack costs ~4 minutes of
# runner time and there is no reason to pay it twice. The gate prints a separate GO/NO-GO line
# per criterion, so folding them together costs no signal. Before them the gate
# checks that the stack runs this job's matrix version (ES_LOCAL_VERSION, which
# must be in kibana.SUPPORTED_VERSIONS) and names it on each GO line (D53),
# and refuses a shell KIBANA_URL/KIBANA_TEST_API_KEY that differs from
# elastic-start-local/.env.seed (D56; the job exports neither).
#
# dod.config is the canonical criteria list. This file must still declare every
# known criterion — the gate fails closed on omissions, which is also the drift
# guard: a criterion added to the gate makes this file exit 2 until it is
# declared here. `n/a` here means "certified by another CI job or by the local
# gate", never "waived": the fast criteria run in checks.yml via the make
# leaves; streams/fleet run in the sibling integration jobs; e2e_green is n/a
# in every config, dod.config included: the live model runs on demand,
# `make test-e2e` (D61, superseding D42; D38, docs/e2e-setup.md).
unit_green = n/a
ruff_clean = n/a
types_clean = n/a
import_contracts = n/a
hygiene_hooks = n/a
docs_strict = n/a
audit_clean = n/a
sast_clean = n/a
vocabulary_conformant = n/a
image_smoke = n/a
# contract_green and the three replays scan every tool result for secrets (D59);
# CI's `scripts/stack.sh seed` creates the canaries the scan looks for.
# contract_green includes the read-tool sweep (D60): every read-tier tool once
# through a fastmcp Client on the full server.
contract_green = required
e2e_replay_green = required
wheel_replay_green = required
image_replay_green = required
e2e_green = n/a
streams_ephemeral = n/a
fleet_ephemeral = n/a
# changelog_entry: checks.yml runs the same script (scripts/checks/changelog-entry.sh)
# on every PR, against the PR's merge-base with main (D54).
changelog_entry = n/a
