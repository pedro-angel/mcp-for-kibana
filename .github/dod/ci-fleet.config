# CI tier slice of the Definition-of-Done gate: FLEET-EPHEMERAL ONLY.
# Run by .github/workflows/integration.yml's `fleet-ephemeral` job:
#   scripts/checks/definition-of-done.sh .github/dod/ci-fleet.config
# The criterion's harness (scripts/fleet_ephemeral.sh) provisions and tears
# down its own isolated 2-agent fleet stack — the job needs only docker + uv.
# Its "dev stack must be stopped" guard passes trivially on a fresh runner.
#
# dod.config is the canonical criteria list; every known criterion must be
# declared here (the gate fails closed on omissions — that is the drift guard).
# `n/a` means "certified by another CI job or by the local gate", never
# "waived"; e2e_green is local-only (needs a provisioned LM Studio runtime +
# model — docs/e2e-setup.md).
unit_green = n/a
ruff_clean = n/a
types_clean = n/a
import_contracts = n/a
hygiene_hooks = n/a
docs_strict = n/a
audit_clean = n/a
sast_clean = n/a
vocabulary_conformant = n/a
image_smoke = n/a
contract_green = n/a
e2e_replay_green = n/a
e2e_green = n/a
streams_ephemeral = n/a
fleet_ephemeral = required
changelog_entry = n/a
