# CI tier slice of the Definition-of-Done gate: FLEET-UNAWARE-EPHEMERAL ONLY (D63).
# Run by .github/workflows/integration.yml's `fleet-unaware-ephemeral` job:
#   scripts/checks/definition-of-done.sh .github/dod/ci-fleet-unaware.config
# The criterion's harness (scripts/fleet_unaware_ephemeral.sh) provisions and
# tears down its own isolated Fleet stack with space awareness OFF — the job
# needs only docker + uv. Its "dev stack must be stopped" guard passes
# trivially on a fresh runner.
# The job fans out over every supported Kibana line: its matrix sets
# ES_LOCAL_VERSION, which the harness writes over the .env.ephemeral.example
# pin (scripts/stack-version.sh, D62).
#
# dod.config is the canonical criteria list; every known criterion must be
# declared here (the gate fails closed on omissions — that is the drift guard).
# `n/a` means "certified by another CI job or by the local gate", never
# "waived"; e2e_green is n/a in every config, dod.config included: the live
# model runs on demand, `make test-e2e` (D61; docs/e2e-setup.md).
unit_green = n/a
ruff_clean = n/a
types_clean = n/a
import_contracts = n/a
hygiene_hooks = n/a
docs_strict = n/a
audit_clean = n/a
sast_clean = n/a
vocabulary_conformant = n/a
image_smoke = n/a
contract_green = n/a
e2e_replay_green = n/a
wheel_replay_green = n/a
image_replay_green = n/a
e2e_green = n/a
streams_ephemeral = n/a
fleet_ephemeral = n/a
fleet_unaware_ephemeral = required
# changelog_entry: checks.yml runs the same script (scripts/checks/changelog-entry.sh)
# on every PR, against the PR's merge-base with main (D54).
changelog_entry = n/a
