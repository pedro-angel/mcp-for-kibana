# Definition-of-Done criteria for mcp-for-kibana.
# Each criterion is `required` or `n/a`. The gate (scripts/checks/definition-of-done.sh)
# runs every REQUIRED check and emits GO / NO-GO — completion and release claims are
# certified by tooling, never self-certified by the author (human or agent).
#
# Concept adapted from cmanaha/extended-superpowers (MIT).
#
# Whatever this file declares, the gate binds its verdict to a tree (D55): the
# header and the VERDICT line name HEAD, the content tree id (uncommitted and
# untracked work included) and clean/dirty; a tree that changed during the run
# is NO-GO `tree_stable`, which is part of the gate, not a criterion, so it has
# no row here. /tmp/dod-<repo>/verdict.json records the run.

unit_green = required
ruff_clean = required
# `uv run mypy` — strict, config in pyproject [tool.mypy]. The package ships a
# py.typed marker and the Typing::Typed classifier, so consumers type-check
# THROUGH this codebase; strict is what makes that claim true.
types_clean = required
import_contracts = required
hygiene_hooks = required
docs_strict = required
# Security gates (issue #14): audit_clean = uv run pip-audit;
# sast_clean = uv run bandit -r src/ -ll -q. Same commands as make audit/sast.
audit_clean = required
sast_clean = required
# Make targets conform to the shared cross-repo vocabulary, checked by the
# vocabulary-conformance hook pinned in .pre-commit-config.yaml.
vocabulary_conformant = required
# Ship artifact: build the Docker image and smoke-test that it boots and answers
# HTTP (docker build + scripts/checks/image-smoke.sh — the same two commands as
# `make build`, which CI's image job also runs). Folding it in here means the
# release gate covers the image build+smoke too, so `make dod` is a superset of
# CI's content/artifact gates plus the live-infra tiers CI can't run. Needs docker.
image_smoke = required
# The seeded-stack criteria (contract_green, e2e_replay_green, wheel_replay_green,
# e2e_green) first check that the stack runs the elastic-start-local/.env.example
# pin — the newest Kibana version kibana-py supports (D30) — and NO-GO naming
# `scripts/stack.sh down && scripts/stack.sh up && scripts/stack.sh seed` on any
# other version; their GO lines name it (D53). The check lives inside them, so
# it has no row of its own. It also refuses a shell KIBANA_URL or
# KIBANA_TEST_API_KEY that differs from elastic-start-local/.env.seed (D56):
# the gate certifies the seeded local stack. Every suite criterion's line shows
# `N passed / M collected`, and the gate clears PYTEST_ADDOPTS and the other
# variables that reshape the suites before any of them runs (D56).
# contract_green includes the privilege matrix (D58): every space-taking tool and
# listing guard under three restricted keys from the shared restricted_key fixture.
contract_green = required
# The model-facing MCP surface, proven with no model in the loop: a real MCP
# client over real stdio replays a RECORDED real-model turn against the real
# server and real Kibana. Deterministic, so this one also runs in CI — it is
# what makes the e2e path a per-PR gate instead of a laptop-only ritual.
e2e_replay_green = required
# The replay again, against the built wheel installed into a fresh venv
# (scripts/checks/wheel-replay.sh) — the artifact PyPI users install, with
# dependencies resolved from the pyproject ranges rather than uv.lock. Every
# other live tier runs the checkout. Deterministic, so CI runs it too.
wheel_replay_green = required
# The live-model gate: a real LLM must choose the calls itself. Deliberately
# NOT the same criterion as e2e_replay_green — replay proves the surface works,
# this proves a model can drive it. Required here by decision D42 (owner, Q16,
# 2026-10-17), superseding D31's `n/a`: the gate runs `make test-e2e`'s
# selection — headless Claude Code (`claude -p`) with only this server's tools
# through the pre-registered tasks (scripts/experiment/CLAUDE_E2E.md), model
# CLAUDE_E2E_MODEL, default the `haiku` alias (D38). It needs a seeded stack
# and a signed-in `claude` CLI (no API key); a missing CLI or sign-in is NO-GO
# naming the fix. About 5-6 minutes per gate run. A pass certifies the model
# that ran. Still n/a in every .github/dod tier: CI has no Claude sign-in.
# `make test-e2e-local` (LM Studio, small local models) is outside every gate.
e2e_green = required
# The streams disable/enable destructive path can't run against the shared dev
# stack (it deletes all wired streams). scripts/ephemeral_stack.sh spins up an
# isolated single-node stack, exercises disable->enable, and tears it down —
# tooling-certified, not an author-attested manual run (#58).
streams_ephemeral = required
# The fleet agent-lifecycle path (reassign/upgrade/unenroll) mutates REAL enrolled
# agents, so it can't run against the shared dev stack's always-on demo agent.
# scripts/fleet_ephemeral.sh spins up an isolated 2-agent fleet stack, exercises the
# lifecycle + output-promotion outcomes, and tears it down — tooling-certified (#81).
fleet_ephemeral = required
# Required from 2026-08-09. It was `n/a` "until releases start", and that gap let a
# whole session's work — a type gate, a new test tier, a container healthcheck and
# two CVE fixes — ship with no CHANGELOG entry at all. Diff-based since D54
# (scripts/checks/changelog-entry.sh): when anything changed since
# `git merge-base HEAD origin/main` (fallback: the latest v* tag; committed,
# staged, unstaged and untracked files) outside the exemption list
# (scripts/experiment/runs/, .claude/plans/; renames count at the old path),
# CHANGELOG.md must gain an entry under `## [Unreleased]` — more non-blank,
# non-heading lines than the base, one at least with text the base lacks — or a
# release section with a new version. Without origin/main or a tag, or when git
# fails, it is NO-GO naming the fetch.
# Before D54 it only checked that the heading existed, which every tree has.
# checks.yml runs the same script on every PR.
changelog_entry = required
