# Definition-of-Done criteria for mcp-for-kibana.
# Each criterion is `required` or `n/a`. The gate (scripts/checks/definition-of-done.sh)
# runs every REQUIRED check and emits GO / NO-GO — completion and release claims are
# certified by tooling, never self-certified by the author (human or agent).
#
# Concept adapted from cmanaha/extended-superpowers (MIT).

unit_green = required
ruff_clean = required
# `uv run mypy` — strict, config in pyproject [tool.mypy]. The package ships a
# py.typed marker and the Typing::Typed classifier, so consumers type-check
# THROUGH this codebase; strict is what makes that claim true.
types_clean = required
import_contracts = required
hygiene_hooks = required
docs_strict = required
# Security gates (issue #14): audit_clean = uv run pip-audit;
# sast_clean = uv run bandit -r src/ -ll -q. Same commands as make audit/sast.
audit_clean = required
sast_clean = required
# Make targets conform to the shared cross-repo vocabulary, checked by the
# vocabulary-conformance hook pinned in .pre-commit-config.yaml.
vocabulary_conformant = required
# Ship artifact: build the Docker image and smoke-test that it boots and answers
# HTTP (docker build + scripts/checks/image-smoke.sh — the same two commands as
# `make build`, which CI's image job also runs). Folding it in here means the
# release gate covers the image build+smoke too, so `make dod` is a superset of
# CI's content/artifact gates plus the live-infra tiers CI can't run. Needs docker.
image_smoke = required
contract_green = required
# The model-facing MCP surface, proven with no model in the loop: a real MCP
# client over real stdio replays a RECORDED real-model turn against the real
# server and real Kibana. Deterministic, so this one also runs in CI — it is
# what makes the e2e path a per-PR gate instead of a laptop-only ritual.
e2e_replay_green = required
# The live-model gate: a real LLM must choose the calls itself. Deliberately
# NOT the same criterion as e2e_replay_green — replay proves the surface works,
# this proves a model can drive it. Local-only (needs an LM Studio runtime +
# model, docs/e2e-setup.md), so every .github/dod tier marks it n/a.
e2e_green = required
# The streams disable/enable destructive path can't run against the shared dev
# stack (it deletes all wired streams). scripts/ephemeral_stack.sh spins up an
# isolated single-node stack, exercises disable->enable, and tears it down —
# tooling-certified, not an author-attested manual run (#58).
streams_ephemeral = required
# The fleet agent-lifecycle path (reassign/upgrade/unenroll) mutates REAL enrolled
# agents, so it can't run against the shared dev stack's always-on demo agent.
# scripts/fleet_ephemeral.sh spins up an isolated 2-agent fleet stack, exercises the
# lifecycle + output-promotion outcomes, and tears it down — tooling-certified (#81).
fleet_ephemeral = required
# Required from 2026-08-09. It was `n/a` "until releases start", and that gap let a
# whole session's work — a type gate, a new test tier, a container healthcheck and
# two CVE fixes — ship with no CHANGELOG entry at all. The gate now refuses any
# completion claim that leaves the changelog untouched, which is the point of
# having a gate rather than a habit.
changelog_entry = required
