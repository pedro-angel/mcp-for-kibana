# .env.local — user-owned dev config for the E2E test (git-ignored; THIS .example
# template is committed, per .gitignore, and is the sanctioned way back in).
# Copy to `.env.local` and adjust for your machine:  cp .env.local.example .env.local
#
# Values below are NON-SECRET local-dev defaults (readable on purpose). The one
# secret — LMSTUDIO_API_TOKEN — is left blank here; put your real token in the
# git-ignored .env.local, never in this template.

# Model loaded in LM Studio that the e2e test drives (LMSTUDIO_MODEL).
LMSTUDIO_MODEL=google/gemma-4-12b-qat

# LM Studio base URL (native /api/v1 REST API).
LMSTUDIO_URL=http://localhost:1234

# Secret: your LM Studio API token, ONLY if "Require Authentication" is on.
# Leave blank in this template; set the real value in your git-ignored .env.local.
LMSTUDIO_API_TOKEN=
