# OpenTelemetry span export for the mcp-for-kibana server (Phase C). Additive and
# OFF by default. Copy the vars you need into .env.local, your launcher's env, or
# your shell — this file is a committed, non-secret template (real env files stay
# git-ignored; see .env.local.example for the split).
#
# The server is instrumented by FastMCP regardless; these take effect only when
# the OTEL SDK is installed (pip install 'mcp-for-kibana[otel]') AND enabled below.

# Master switch — install a tracer provider + OTLP exporter (default: false/off).
KIBANA_MCP_OTEL_ENABLED=true

# OTLP/HTTP endpoint base (the server appends /v1/traces). Default targets the
# local APM from the stack: `KIBANA_MCP_STACK_APM=1 scripts/stack.sh up`.
KIBANA_MCP_OTEL_ENDPOINT=http://localhost:18200

# Bearer token for the APM/OTLP endpoint (it is token-gated — exports without it
# are rejected 401). This local-dev default matches ELASTIC_APM_SECRET_TOKEN in
# elastic-start-local/.env.example; set your real token in production.
KIBANA_MCP_OTEL_SECRET_TOKEN=mcp-for-kibana-dev-apm-token

# Service name the traces show up under (Kibana APM / ES traces-apm*).
KIBANA_MCP_OTEL_SERVICE_NAME=mcp-for-kibana

# Standard OpenTelemetry env vars are also honored by the SDK, e.g.:
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev,service.version=0.1.0
