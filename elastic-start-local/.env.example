# Single source of truth for the local test stack (elastic start-local near-copy).
# Consumed by docker compose and scripts/stack.sh; regenerated to .env on `up`.
# Non-secret dev constants — safe to track. Ports/version/names live ONLY here.
#
# Host ports are 19200/15601, not the "natural" 9200/5601: this avoids clashing
# with an unrelated local Kibana (or kibana-py's own elastic-start-local stack)
# that already owns 9200/5601 on the same machine. Container names and the
# compose project (mcp-for-kibana-stack) are namespaced for the same reason.
ES_LOCAL_VERSION=9.4.3
ES_LOCAL_CONTAINER_NAME=mcp-for-kibana-es-local
ES_LOCAL_PORT=19200
ES_LOCAL_URL=http://localhost:${ES_LOCAL_PORT}
ES_LOCAL_PASSWORD=mcp-for-kibana-es-dev
ES_LOCAL_JAVA_OPTS="-Xms2g -Xmx2g"
ES_LOCAL_DISK_SPACE_REQUIRED=1gb
KIBANA_LOCAL_CONTAINER_NAME=mcp-for-kibana-kibana-local
KIBANA_LOCAL_SETTINGS_CONTAINER_NAME=mcp-for-kibana-kibana-settings
KIBANA_LOCAL_PORT=15601
KIBANA_LOCAL_URL=http://localhost:${KIBANA_LOCAL_PORT}
KIBANA_LOCAL_PASSWORD=mcp-for-kibana-kbn-dev
KIBANA_ENCRYPTION_KEY=mcp-for-kibana-dev-encryption-key-0123456789abcdef

# APM server (docker-compose.apm.yml) — the local OpenTelemetry backend the
# instrumented MCP server exports to (Phase C). Opt-in and off by default: only
# `KIBANA_MCP_STACK_APM=1 scripts/stack.sh up` starts it, so the common contract/
# e2e path stays cheap and a (test-irrelevant) APM failure can't break it. Host
# port 18200, not the natural 8200, to coexist with kibana-py's own stack. The
# secret token gates a 127.0.0.1-only server — same non-secret dev tier as the
# passwords above. It IS enforced: apm-server.auth.secret_token (the pre-8.x
# apm-server.secret_token is silently ignored on 9.x).
APM_LOCAL_CONTAINER_NAME=mcp-for-kibana-apm-local
APM_LOCAL_PORT=18200
ELASTIC_APM_SECRET_TOKEN=mcp-for-kibana-dev-apm-token

# Fleet Server + one enrolled demo agent (docker-compose.fleet.yml). UNLIKE the
# opt-in APM overlay, fleet is ALWAYS part of the dev/test stack: the server
# exposes a `fleet` toolbox, so fleet must be running and contract-tested. The
# fleet-server self-registers as one agent and the demo agent enrolls into it, so
# the fleet read tools always have non-empty data. Host port 18220 (not the
# natural 8220) to coexist with a sibling stack; loopback-only like the rest. The
# service token + enrollment token are minted at runtime by scripts/stack.sh into
# the gitignored elastic-start-local/.env.fleet — never committed.
FLEET_LOCAL_CONTAINER_NAME=mcp-for-kibana-fleet-local
FLEET_AGENT_LOCAL_CONTAINER_NAME=mcp-for-kibana-fleet-agent-local
FLEET_LOCAL_PORT=18220
