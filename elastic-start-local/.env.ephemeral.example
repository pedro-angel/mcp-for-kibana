# Isolated ephemeral stack for the streams disable/enable DoD certification.
# Namespaced away from the dev stack (mcp-for-kibana-stack, 19200/15601, mcp-for-kibana-*-local)
# so both can run at once: distinct container names, ports (29200/25601), and creds.
# scripts/ephemeral_stack.sh copies this to the gitignored .env.ephemeral and uses it
# as the compose --env-file under project mcp-for-kibana-ephemeral.
ES_LOCAL_VERSION=9.4.3
ES_LOCAL_CONTAINER_NAME=mcp-for-kibana-eph-es
ES_LOCAL_PORT=29200
ES_LOCAL_URL=http://localhost:${ES_LOCAL_PORT}
ES_LOCAL_PASSWORD=mcp-for-kibana-eph-es-dev
# Smaller heap than the dev stack (2g): this is a transient single-node stack that
# only lists/forks/disables streams, so 1g keeps its footprint down when it has to
# coexist with another Elastic stack on a memory-constrained Docker VM.
ES_LOCAL_JAVA_OPTS="-Xms1g -Xmx1g"
ES_LOCAL_DISK_SPACE_REQUIRED=1gb
KIBANA_LOCAL_CONTAINER_NAME=mcp-for-kibana-eph-kibana
KIBANA_LOCAL_SETTINGS_CONTAINER_NAME=mcp-for-kibana-eph-settings
KIBANA_LOCAL_PORT=25601
KIBANA_LOCAL_URL=http://localhost:${KIBANA_LOCAL_PORT}
KIBANA_LOCAL_PASSWORD=mcp-for-kibana-eph-kbn-dev
KIBANA_ENCRYPTION_KEY=mcp-for-kibana-eph-encryption-key-0123456789abcdef

# Fleet overlay (docker-compose.fleet.yml) for the fleet_ephemeral harness only:
# a Fleet Server + TWO sacrificial enrolled agents on THIS isolated stack, used to
# battle-test the fleet agent-lifecycle tools. scripts/ephemeral_stack.sh (streams)
# ignores these — it never loads the fleet overlay. Distinct container names + a
# distinct host port from the dev stack (18220) so the two could theoretically
# coexist (they never run at once — RAM). The service + enrollment tokens are NOT
# here: scripts/fleet_ephemeral.sh mints them at runtime into the gitignored
# elastic-start-local/.env.fleet.ephemeral (never committed).
FLEET_LOCAL_CONTAINER_NAME=mcp-for-kibana-eph-fleet
FLEET_AGENT_LOCAL_CONTAINER_NAME=mcp-for-kibana-eph-fleet-agent
FLEET_AGENT2_LOCAL_CONTAINER_NAME=mcp-for-kibana-eph-fleet-agent-2
FLEET_LOCAL_PORT=28220
